# Optional local settings. Environment variables override values in .env.
UGSL_SERVICE_NAME=ugsl-ai-practice-coach
UGSL_ENVIRONMENT=development
UGSL_LOG_LEVEL=INFO
# Required only by explicit PostgreSQL runtime/migration invocation.
UGSL_DATABASE_URL=
UGSL_WORKER_LEASE_SECONDS=300
UGSL_WORKER_POLL_SECONDS=1.0
# Optional dedicated PostgreSQL test database (tests create isolated schemas).
UGSL_TEST_DATABASE_URL=
