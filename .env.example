# Optional local settings. Environment variables override values in .env.
UGSL_SERVICE_NAME=ugsl-ai-practice-coach
UGSL_ENVIRONMENT=development
# Defaults to off in production, on in development. Contract schemas stay available.
# UGSL_API_DOCS_ENABLED=false
UGSL_LOG_LEVEL=INFO
# Required only by explicit PostgreSQL runtime/migration invocation.
UGSL_DATABASE_URL=
UGSL_WORKER_LEASE_SECONDS=300
UGSL_WORKER_POLL_SECONDS=1.0
# Optional dedicated PostgreSQL test database (tests create isolated schemas).
UGSL_TEST_DATABASE_URL=
# Internal API only. Generate a random bearer token (32 random bytes or more).
# Blank leaves protected API operations unavailable; health/schema remain usable.
UGSL_SERVICE_TOKEN=
# Private S3-compatible storage; standard AWS/Boto credential provider chain.
UGSL_OBJECT_STORE_BUCKET=
UGSL_OBJECT_STORE_REGION=
# Leave blank for the native AWS S3 endpoint. Never supply this in API requests.
UGSL_OBJECT_STORE_ENDPOINT_URL=
UGSL_LEARNER_VIDEO_PREFIX=learner-videos/
UGSL_REFERENCE_PROFILE_PREFIX=reference-profiles/
# 50 MiB short-practice video; 5 MiB precomputed expert JSON profile.
UGSL_MAX_VIDEO_BYTES=52428800
UGSL_MAX_REFERENCE_BYTES=5242880
# Optional overrides of the hash-verified packaged M3 assets. Profiles must match.
UGSL_HAND_MODEL_PATH=
UGSL_POSE_MODEL_PATH=
# M6E engineering delivery/capacity defaults, not learner/product policy.
UGSL_COACHING_LEASE_SECONDS=300
UGSL_COACHING_POLL_SECONDS=1.0
UGSL_COACHING_RETRY_BASE_SECONDS=5
UGSL_COACHING_RETRY_MAX_SECONDS=300
UGSL_SUBMIT_RATE_LIMIT_PER_MINUTE=60
UGSL_READ_RATE_LIMIT_PER_MINUTE=600
# Only service-owned abandoned local download directories; never S3/history.
UGSL_TEMP_MEDIA_MAX_AGE_SECONDS=86400
